# Store Assets Studio - Configuration Template
# Copy this file to .env and adjust variables as needed.

# Render Service Port (default: 8787, in Docker: 8080)
PORT=8787

# Rate Limiting: Max exports per IP per day (0 = disabled / unlimited for self-hosters)
RATE_LIMIT_PER_DAY=0

# Concurrency: Max simultaneous Chromium renders
MAX_CONCURRENT_RENDERS=4

# CORS Allowed Origins (* or comma-separated list of URLs)
ALLOWED_ORIGINS=*

# Optional: Google Analytics 4 Measurement ID (leave empty to disable tracking)
VITE_GA_ID=
